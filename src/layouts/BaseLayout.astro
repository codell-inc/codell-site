---
interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  fontHref: string;
  canonicalPath?: string;
}

const { title, description, bodyClass, fontHref, canonicalPath } = Astro.props;
const canonicalUrl = Astro.site ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (gtag.js): loaded on the first interaction so it does not compete with the first render -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18448674355');
      gtag('config', 'G-NQRKD9GH73');
      (function () {
        var events = ['pointerdown', 'keydown', 'touchstart', 'scroll', 'wheel'];
        var load = function () {
          events.forEach(function (name) { removeEventListener(name, load, { passive: true }); });
          var tag = document.createElement('script');
          tag.async = true;
          tag.src = 'https://www.googletagmanager.com/gtag/js?id=AW-18448674355';
          document.head.appendChild(tag);
        };
        events.forEach(function (name) { addEventListener(name, load, { once: true, passive: true }); });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="google-site-verification" content="WRuDqrH3LYfgwCiDYgzDYKgbrAVywEOlzMR57KYz8ws" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {fontHref.startsWith("https://fonts.googleapis.com/") && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {fontHref.startsWith("https://fonts.googleapis.com/") && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    <!-- Web fonts are requested only after the first paint, so they never delay it (text renders in a system font first) -->
    <script is:inline define:vars={{ fontHref }}>
      var fontsLoaded = false;
      var loadFonts = function () {
        if (fontsLoaded) return;
        fontsLoaded = true;
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.setAttribute('href', fontHref);
        document.head.appendChild(link);
      };
      try {
        new PerformanceObserver(function (list) {
          if (list.getEntriesByName('first-contentful-paint').length) loadFonts();
        }).observe({ type: 'paint', buffered: true });
      } catch (error) {
        addEventListener('load', loadFonts);
      }
      setTimeout(loadFonts, 3000);
    </script>
    <noscript><link href={fontHref} rel="stylesheet" /></noscript>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
