---
import SonovadeFooter from "../components/sonovade/SonovadeFooter.astro";
import SonovadeHeader from "../components/sonovade/SonovadeHeader.astro";
import { organizationId, websiteId } from "../data/structured-data";
import "../styles/sonovade.css";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site!;
const pageUrl = new URL("/sonovade/", site).href;
const imageUrl = new URL("/sonovade/assets/lp/plan.jpg", site).href;
const structuredData = [
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: "ja",
    isPartOf: { "@id": websiteId(site) },
    publisher: { "@id": organizationId(site) },
    about: { "@id": `${pageUrl}#software` },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: imageUrl,
      width: 1194,
      height: 834,
    },
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#software`,
    name: "ソノバデ",
    description: "介護保険住宅改修の図面作成・部材計算・見積書出力・申請書類作成をタブレットやPCで進める業務支援ソフト",
    applicationCategory: "BusinessApplication",
    url: pageUrl,
    image: imageUrl,
    publisher: { "@id": organizationId(site) },
  },
];
// Subset fonts generated at build time by scripts/build-fonts.mjs.
const fontHref = "/fonts/fonts.css";
---

<BaseLayout {title} {description} {fontHref} {structuredData} canonicalPath="/sonovade/">
  <Fragment slot="head">
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Codell" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1194" />
    <meta property="og:image:height" content="834" />
    <meta property="og:image:alt" content="ソノバデで手すりの施工箇所と寸法を入力した住宅改修図面" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="ソノバデの住宅改修図面作成画面" />
  </Fragment>
  <SonovadeHeader />
  <main>
    <slot />
  </main>
  <SonovadeFooter />
</BaseLayout>

<script>
  import "../scripts/sonovade-nav";
</script>
