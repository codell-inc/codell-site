---
import CorporateFooter from "../components/corporate/CorporateFooter.astro";
import CorporateHeader from "../components/corporate/CorporateHeader.astro";
import "../styles/corporate.css";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
  bodyClass?: string;
  canonicalPath?: string;
}

const { title, description, isHome = false, bodyClass, canonicalPath } = Astro.props;
// Subset fonts generated at build time by scripts/build-fonts.mjs.
const fontHref = "/fonts/fonts.css";
---

<BaseLayout {title} {description} {bodyClass} {fontHref} {canonicalPath}>
  <style is:inline slot="head">:root { --main-visual: url("/assets/main-visual-960.webp"); } @media (min-width: 961px) { :root { --main-visual: url("/assets/main-visual-1920.webp"); } }</style>
  <CorporateHeader {isHome} />
  <main id="top">
    <slot />
  </main>
  <CorporateFooter {isHome} />
</BaseLayout>

<script>
  import "../scripts/corporate-nav";
</script>
