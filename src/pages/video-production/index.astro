---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/video-production/Icon.astro";
import { contactHref, faqs, steps, strengths, useCases } from "../../data/video-production";
import "../../styles/video-production.css";

const title = "動画制作 | 伝えたい魅力を、30秒の映像に。 | Codell";
const description = "商品やサービスの魅力を、AIを活用した30秒の映像に。Codellが企画・構成から映像制作・編集までお手伝いします。制作例・料金・制作の流れをご覧いただけます。";
const fontHref = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700;750;800&family=Noto+Sans+JP:wght@400;500;600;700;800;900&display=swap";
---

<BaseLayout {title} {description} {fontHref} bodyClass="video-production" canonicalPath="/video-production/">
  <meta slot="head" property="og:image" content="https://codell.jp/video-production/assets/hero.webp" />
  <a class="vp-skip" href="#main">本文へスキップ</a>
  <header class="vp-header">
    <div class="vp-header-inner">
      <a class="vp-brand" href="/" aria-label="Codell 会社サイトへ"><img src="/assets/codell-logo.svg" alt="Codell" width="120" height="50" /><span>動画制作サービス</span></a>
      <nav class="vp-nav" aria-label="ページ内ナビゲーション">
        <a href="#works">制作例</a><a href="#service">サービス</a><a href="#pricing">料金</a><a href="#faq">よくある質問</a>
      </nav>
      <a class="vp-button vp-button-coral vp-header-cta" href={contactHref}>無料で相談する <Icon name="arrow" size={17} /></a>
    </div>
  </header>

  <main id="main">
    <section class="vp-hero" aria-labelledby="hero-title">
      <img class="vp-hero-image" src="/video-production/assets/hero.webp" alt="" width="1659" height="948" fetchpriority="high" />
      <div class="vp-hero-shade"></div>
      <div class="vp-container vp-hero-content">
        <p class="vp-eyebrow"><span></span> AIを活用した、商品・サービス紹介動画</p>
        <h1 id="hero-title">伝えたい魅力を、<br /><span>30秒</span>の映像に。</h1>
        <p class="vp-hero-lead">言葉だけでは、伝えきれない価値がある。<br />あなたの商品やサービスの魅力を、<br class="vp-mobile-break" />印象に残る映像で届けます。</p>
        <div class="vp-actions"><a class="vp-button vp-button-navy" href="#works"><Icon name="play" size={18} /> 制作例を見る</a><a class="vp-button vp-button-white" href={contactHref}>無料で相談する <Icon name="arrow" size={18} /></a></div>
        <div class="vp-hero-notes"><span>企画・構成からお任せ</span><span>30秒のショート動画</span><span>初めての動画制作にも</span></div>
      </div>
      <span class="vp-image-note">AI generated / コンセプトイメージ</span>
      <div class="vp-hero-bottom"><span>その魅力に、<strong>映像という選択肢を。</strong></span><a href="#works">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="vp-section vp-container" id="works" aria-labelledby="works-title">
      <div class="vp-section-head"><div><p class="vp-section-label"><span>01</span> WORKS</p><h2 id="works-title">まずは、映像で<br class="vp-mobile-break" />ご覧ください。</h2></div><p>自社サービスの紹介映像です。<br />約30秒で、価値と使うシーンを伝えます。</p></div>
      <div class="vp-work-grid">
        <article class="vp-work">
          <div class="vp-video-wrap"><video controls playsinline preload="none" poster="/sonovade/assets/lp/movie-poster.jpg" aria-label="ソノバデのサービス紹介動画、約32秒" aria-describedby="sonovade-description"><source src="/sonovade/assets/lp/sonovade-pr-v1.mp4" type="video/mp4" /><p><a href="/sonovade/assets/lp/sonovade-pr-v1.mp4">ソノバデの紹介動画をダウンロード</a></p></video><span class="vp-video-badge">SERVICE FILM <span>0:32</span></span></div>
          <div class="vp-work-meta"><div><p class="vp-kicker">住宅改修 SaaS / 自社サービス</p><h3>ソノバデ <span>Sonovade</span></h3></div><a href="/sonovade/" class="vp-circle-link" aria-label="ソノバデのサービス詳細へ"><Icon name="arrow" /></a></div>
          <p id="sonovade-description">現場調査から見積・申請書類の作成まで。実際の利用シーンを交えて、サービスの特徴を紹介します。</p>
        </article>
        <article class="vp-work">
          <div class="vp-video-wrap"><video controls playsinline preload="none" poster="/video-production/assets/kiduki-poster.jpg" aria-label="KiDUKiのサービス紹介動画、約33秒" aria-describedby="kiduki-description"><source src="/video-production/assets/kiduki-pr.mp4" type="video/mp4" /><p><a href="/video-production/assets/kiduki-pr.mp4">KiDUKiの紹介動画をダウンロード</a></p></video><span class="vp-video-badge">SERVICE FILM <span>0:33</span></span></div>
          <div class="vp-work-meta"><div><p class="vp-kicker">介護 × AR / 自社サービス</p><h3>KiDUKi <span>キヅキ</span></h3></div><a href="https://kiduki.codell.jp/" class="vp-circle-link" aria-label="KiDUKiのサービス詳細へ"><Icon name="arrow" /></a></div>
          <p id="kiduki-description">介護の現場で、必要な情報を目の前に。ARグラスを使ったサービスの体験と、目指す未来を紹介します。</p>
        </article>
      </div>
      <p class="vp-fine vp-play-note">再生すると音声が流れます。プレーヤーで音量・再生速度・全画面表示を操作できます。</p>
      <div class="vp-samples-head"><h3>こんな世界観も、映像に。</h3><p>以下はAI生成の静止画による制作イメージです。<br />受託実績・完成動画ではありません。</p></div>
      <div class="vp-sample-grid">
        <figure><div><img src="/video-production/assets/product-concept.webp" alt="緑の中に佇む、架空のドリンクボトルのイメージ" width="1200" height="675" loading="lazy" /><span>AI生成イメージ</span></div><figcaption><strong>商品のこだわりを、ひと目で。</strong><span>食品・飲料 / 商品紹介の表現例</span></figcaption></figure>
        <figure><div><img src="/video-production/assets/interior-concept.webp" alt="朝の光が差し込む、木と白を基調にした架空のリビング" width="1200" height="675" loading="lazy" /><span>AI生成イメージ</span></div><figcaption><strong>空間の心地よさまで、届ける。</strong><span>住まい・インテリア / 空間紹介の表現例</span></figcaption></figure>
      </div>
    </section>

    <section class="vp-section vp-tint" id="service" aria-labelledby="service-title"><div class="vp-container">
      <div class="vp-section-head"><div><p class="vp-section-label"><span>02</span> SERVICE</p><h2 id="service-title">魅力をひもとき、<br />伝わる30秒をつくる。</h2></div><p>企画・構成から映像制作まで、一貫して。<br />AIを活用し、あなたの「伝えたい」を形にします。</p></div>
      <div class="vp-service-grid">
        <article class="vp-service-card"><div class="vp-service-top"><span>PRODUCT</span><Icon name="film" size={34} /></div><h3>商品紹介動画</h3><p>形、質感、使う瞬間。<br />商品の魅力を、印象に残る映像に。</p><ul><li>新商品の世界観を伝えたい</li><li>機能や使い方をわかりやすく見せたい</li><li>ECサイト・SNSで活用したい</li></ul></article>
        <article class="vp-service-card"><div class="vp-service-top"><span>SERVICE</span><Icon name="layers" size={34} /></div><h3>サービス紹介動画</h3><p>できること、その先の変化。<br />サービスの価値を、具体的なシーンに。</p><ul><li>サービスの仕組みや価値を伝えたい</li><li>導入後のイメージを見せたい</li><li>営業・展示会・Webサイトで活用したい</li></ul></article>
      </div>
      <div class="vp-subhead"><p class="vp-section-label"><span>03</span> USE CASES</p><h3>いろいろな接点で、<br class="vp-mobile-break" />繰り返し伝える。</h3></div>
      <div class="vp-use-grid">{useCases.map(({icon,title,text}) => <article><Icon name={icon} size={28} /><h4>{title}</h4><p>{text}</p></article>)}</div>
      <p class="vp-fine">用途に応じたサイズ・利用条件は、事前にご相談ください。</p>
    </div></section>

    <section class="vp-section vp-container" aria-labelledby="strengths-title"><div class="vp-section-head"><div><p class="vp-section-label"><span>04</span> WHY CODELL</p><h2 id="strengths-title">つくる前から、<br />一緒に考える。</h2></div><p>映像をつくることは、魅力を見つめ直すこと。<br />企画と技術、その両方からお手伝いします。</p></div>
      <div class="vp-strength-grid">{strengths.map(({icon,title,text}, i) => <article><div class="vp-strength-icon"><Icon name={icon} size={29} /><span>0{i+1}</span></div><h3>{title}</h3><p>{text}</p></article>)}</div>
    </section>

    <section class="vp-section vp-pricing-section" id="pricing" aria-labelledby="pricing-title"><div class="vp-container">
      <div class="vp-section-head"><div><p class="vp-section-label"><span>05</span> PRICING</p><h2 id="pricing-title">まずは1本、<br class="vp-mobile-break" />始めやすいプランで。</h2></div><p>商品・サービスの紹介を、30秒に。<br />企画から納品までを含む、基本プランです。</p></div>
      <div class="vp-pricing-grid"><div class="vp-price-card"><div class="vp-price-top"><span>2026年10月限定 キャンペーン</span><p>商品紹介動画・サービス紹介動画 <strong>30秒</strong></p></div><div class="vp-price-body"><p class="vp-normal-price">通常価格 <s>70,000円</s><span>（税別）</span></p><p class="vp-price"><span>¥</span>50,000<small>税別</small></p><p class="vp-price-tax">税込 55,000円</p><p class="vp-price-deadline"><Icon name="clock" size={18} /><span><strong>2026年10月31日</strong>までのお申し込みが対象です。<br />11月1日以降は70,000円（税別）となります。</span></p><a class="vp-button vp-button-coral" href={contactHref}>このプランについて相談する <Icon name="arrow" size={20} /></a></div></div>
      <div class="vp-includes"><h3>料金に含まれるもの</h3><ul>{["企画・構成・シナリオ", "AI映像の生成・編集", "BGM（著作権フリー音源の一部から選定）", "AI音声ナレーション、またはナレーションなし", "初稿確認後の修正 1回", "MP4・フルHD（1920×1080）での納品"].map(item => <li><Icon name="check" size={19} />{item}</li>)}</ul><div class="vp-price-note"><p>企画内容や演出の複雑さ、追加の修正・仕様変更などにより、別途費用が発生する場合があります。</p><p>ご依頼内容を確認し、対応範囲とお見積もりをご案内します。</p></div></div></div>
    </div></section>

    <section class="vp-section vp-container" id="process" aria-labelledby="process-title"><div class="vp-section-head"><div><p class="vp-section-label"><span>06</span> PROCESS</p><h2 id="process-title">相談から納品まで、<br class="vp-mobile-break" />5つのステップ。</h2></div><p>まだイメージが固まっていなくても大丈夫。<br />対話を重ねながら、映像を形にしていきます。</p></div>
      <ol class="vp-process">{steps.map(({title,text}, i) => <li><span class="vp-step-number">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol>
      <div class="vp-delivery"><div><p class="vp-section-label"><span>07</span> DELIVERY</p><h3>使いやすいデータで、<br />お手元に。</h3></div><div class="vp-delivery-grid">{[{icon:"file",title:"MP4",text:"フルHD 1920×1080"},{icon:"music",title:"BGM",text:"利用条件を確認して選定"},{icon:"mic",title:"ナレーション",text:"AI音声 / なし"},{icon:"file",title:"構成案",text:"制作時の確認資料"}].map(({icon,title,text}) => <div><Icon name={icon} size={26} /><h4>{title}</h4><p>{text}</p></div>)}</div></div>
    </section>

    <section class="vp-section vp-tint" id="faq" aria-labelledby="faq-title"><div class="vp-container vp-faq-layout"><div><p class="vp-section-label"><span>08</span> FAQ</p><h2 id="faq-title">よくあるご質問</h2><p class="vp-faq-intro">気になることは、<br />ご相談の前にこちらから。</p></div><div class="vp-faq-list">{faqs.map(({question,answer}) => <details><summary><span class="vp-q">Q.</span><span>{question}</span><span class="vp-faq-plus" aria-hidden="true"></span></summary><div class="vp-faq-answer"><span>A.</span><p>{answer}</p></div></details>)}</div></div></section>

    <section class="vp-section vp-contact" id="contact" aria-labelledby="contact-title"><div class="vp-container vp-contact-layout"><div><p class="vp-section-label"><span>09</span> CONTACT</p><h2 id="contact-title">「こんな動画、できる？」<br />から始めましょう。</h2><p>商品やサービスのこと、伝えたい相手のこと。<br />まずは、お話を聞かせてください。<br />企画の段階から、一緒に考えます。</p><a class="vp-button vp-button-coral" href={contactHref}><Icon name="mail" size={24} /><span>無料で相談する<small>Codellのお問い合わせフォームへ</small></span><Icon name="arrow" size={22} /></a></div><aside class="vp-contact-guide"><span>LET'S TALK</span><h3>ご相談のときに、<br />教えていただきたいこと</h3><ul><li>ご紹介したい商品・サービス</li><li>動画を使う場所や、伝えたい相手</li><li>参考にしたい映像やイメージ</li><li>ご希望の納期・ご予算</li></ul><p>すべて決まっていなくても構いません。<br />フォームの「その他」を選び、動画制作のご相談とご記入ください。</p></aside></div></section>
  </main>
  <footer class="vp-footer"><div class="vp-container"><div class="vp-footer-top"><a href="/" class="vp-footer-brand">Codell<span>想いを、かたちに。</span></a><nav aria-label="フッターナビゲーション"><a href="#service">サービス</a><a href="#works">制作例</a><a href="#pricing">料金</a><a href="#faq">よくある質問</a><a href={contactHref}>お問い合わせ</a></nav><a class="vp-to-top" href="#main" aria-label="ページの先頭へ">↑</a></div><div class="vp-footer-bottom"><small>© 2026 Codell Inc.</small><div><a href="/">会社サイト</a><a href="/privacy/">プライバシーポリシー</a></div></div></div></footer>
</BaseLayout>
