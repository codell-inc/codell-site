---
import Tablet from "../../components/sonovade/Tablet.astro";
import SonovadeLayout from "../../layouts/SonovadeLayout.astro";
const title = "ソノバデ | 介護保険住宅改修の見積・図面作成ソフト";
const description = "図面に引いた手すりや扉を、そのまま見積に。ソノバデは、介護保険住宅改修の図面作成・部材計算・見積書出力・申請書類作成をタブレットやPCで進める業務支援ソフトです。30分の無料相談で実際の画面をご覧いただけます。";
const contact = "/contact.html?product=sonovade";
const steps = [
  { number: "01", title: "引くだけ簡単手すり配置", image: "plan", alt: "図面上に手すりを配置するソノバデの画面" },
  { number: "02", title: "アプリ内で部材、施工費調整", image: "parts", alt: "手すりの部材と施工費を調整するソノバデの画面" },
  { number: "03", title: "自動で見積書に反映！", image: "estimate", alt: "入力内容を反映したソノバデの見積書画面" },
];
---
<SonovadeLayout {title} {description}>
  <!-- 文言はFigma 42:165を基準とし、CTAのみ最新指示を優先。削除済みの注記や独自の言い換えを追加しない。 -->
  <!-- PC版Figmaの編集内容を基準に実装。現場写真で対象業務を伝え、PCは100vh・透明ヘッダーにする。 -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <img class="hero-photo" src="/sonovade/assets/lp/hero.jpg" alt="住宅内で寸法を測り、タブレットで現地調査を行う担当者" width="1920" height="1080" fetchpriority="high" />
    <div class="hero-content container">
      <div class="hero-copy">
        <h1 id="hero-title">現地調査中に、<br />即・申請書類作成</h1>
        <p class="hero-lead">タブレットで申請業務を完結。<br class="mobile-break" />住宅改修の新常識</p>
        <a class="button" href={contact}>30分の無料相談を申し込む</a>
        <a class="movie-link" href="#movie">操作動画を見る（30秒）</a>
      </div>
    </div>
    <a class="scroll-cue" href="#workflow" aria-label="使い方を見る"><span aria-hidden="true">↓</span></a>
  </section>

  <!-- 同じ横タブレット枠と最新実画面で、操作の順序を比べられるようにする。 -->
  <section class="workflow band band--mist" id="workflow" aria-labelledby="workflow-title">
    <div class="container">
      <p class="kicker">現地で使う、3つの操作</p>
      <h2 id="workflow-title"><span>タブレットひとつ、</span><span>現地で3ステップ</span></h2>
      <ol class="steps">
        {steps.map((step) => <li>
          <div class="step-heading"><span aria-hidden="true">{step.number}</span><h3>{step.title}</h3></div>
          <Tablet image={step.image} alt={step.alt} />
        </li>)}
      </ol>
    </div>
  </section>

  <!-- 操作の理解を導入メリットにつなぐ。全3点を同じソコスト線画・色・面積で統一。 -->
  <section class="benefits band" id="benefits" aria-labelledby="benefits-title">
    <div class="container">
      <h2 class="benefits-title" id="benefits-title"><span>ソノバデを導入する</span><strong>3つのメリット</strong></h2>
      <div class="benefits-grid">
        <article>
          <div class="benefit-art"><img src="/sonovade/assets/lp/benefit-tablet.svg" alt="" width="141" height="190" loading="lazy" /></div>
          <h3>図面を描くだけ<br /><strong>そのまま見積</strong>に！</h3>
          <p>図面上に引いた手すり、つけた扉が<br />そのまま見積に。申請書類づくりも、<br />入力した情報から進められます。</p>
        </article>
        <article>
          <div class="benefit-art"><img src="/sonovade/assets/lp/benefit-pc.svg" alt="" width="227" height="190" loading="lazy" /></div>
          <h3>細かい作業は<br /><strong>PCでもOK</strong>！</h3>
          <p>部材の細かな調整など、<br />会社に合わせて柔軟に対応可能。</p>
        </article>
        <article>
          <div class="benefit-art"><img src="/sonovade/assets/lp/benefit-files.svg" alt="" width="185" height="190" loading="lazy" /></div>
          <h3>案件ごとの情報を<br /><strong>ひとまとめに</strong>！</h3>
          <p>申請に必要な写真や理由書のあれこれ。<br />「あの情報、どこだっけ？」をなくします。</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 2時間→10分は依頼者指定の想定値。棒の比率は120:10を守る。 -->
  <section class="impact band" aria-labelledby="impact-title">
    <div class="container impact-grid">
      <div>
        <p class="kicker">ソノバデなら、</p>
        <p class="impact-intro">転記,手書き,部材計算がアプリ内で完結！</p>
        <h2 id="impact-title">だから早い！</h2>
        <p>PCでも、タブレットでも使えるから、<br />現地完結でも、事務所作業でも、あらゆるケースに対応可能！</p>
      </div>
      <figure class="time-chart">
        <div class="chart-row"><strong class="chart-value">2時間</strong><div class="chart-track"><span>紙・Excelでの作業</span><div class="chart-bar chart-bar--before" aria-hidden="true"></div></div></div>
        <div class="chart-row"><strong class="chart-value">10分</strong><div class="chart-track"><span>ソノバデ</span><div class="chart-bar chart-bar--after" aria-hidden="true"></div></div></div>
      </figure>
    </div>
  </section>

  <!-- 数字の後に実際の操作動画を見せる。クリック時のみ再生し、音声の自動再生と先行ダウンロードを避ける。 -->
  <section class="movie band" id="movie" aria-label="動画でわかるソノバデ">
    <div class="container">
      <div class="movie-player" data-movie>
        <video controls playsinline preload="none" poster="/sonovade/assets/lp/movie-poster.jpg" aria-label="約30秒でわかるソノバデの操作紹介">
          <source src="/sonovade/assets/lp/sonovade-pr-v1.mp4" type="video/mp4" />
          <p>動画を再生できない場合は<a href="/sonovade/assets/lp/sonovade-pr-v1.mp4">動画ファイルを開いてください</a>。</p>
        </video>
        <button class="movie-play" type="button" aria-label="ソノバデの紹介動画を再生（約30秒）" data-play hidden><img src="/sonovade/assets/lp/play.svg" width="28" height="28" alt="" /></button>
      </div>
    </div>
  </section>

  <!-- 写真整理を大きく、申請書類と基本情報を同じサイズで並べ、周辺業務とのつながりを実画面で示す。 -->
  <section class="capabilities band band--mist" id="features" aria-labelledby="features-title">
    <div class="container">
      <p class="kicker">住宅改修の書類作成を、ひとつに。</p>
      <h2 id="features-title">申請書類作成に必要な<wbr />機能が勢揃い</h2>
      <div class="photo-feature">
        <Tablet image="photo" alt="施工箇所にひもづけた改修前後の写真を管理する画面" />
        <div class="photo-copy">
          <img class="feature-icon" src="/sonovade/assets/lp/photo-icon.svg" width="36" height="36" alt="" loading="lazy" />
          <h3>ここの写真、<wbr />どこに置いたっけ...<br />をなくす！</h3>
          <p>写真を施工箇所ごとに整理。<br />改修前・改修後の写真や注釈を、<br />図面と一緒に管理できます。</p>
        </div>
      </div>
      <div class="supporting-grid">
        <article>
          <p class="feature-label"><img src="/sonovade/assets/lp/document-icon.svg" width="28" height="28" alt="" loading="lazy" />自治体の申請書類</p>
          <Tablet image="forms" alt="登録済み自治体の住宅改修申請書類を作成する画面" />
          <h3>お客様情報を、そのまま申請書類へ！</h3>
          <p>登録済みの自治体様式に合わせて作成。様式ごとの追加項目も入力できます。</p>
        </article>
        <article>
          <p class="feature-label"><img src="/sonovade/assets/lp/plan-icon.svg" width="28" height="28" alt="" loading="lazy" />基本情報の反映</p>
          <Tablet image="information" alt="利用者情報や物件情報を案件ごとに登録する画面" />
          <h3>氏名、住所...繰り返す手間を、一度の登録に！</h3>
          <p>利用者・物件情報を案件にまとめ、対応する書類の項目へ反映します。</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 無料相談コピーをPC版から採用。30分で確認できる内容を既存問い合わせ導線の近くに置く。 -->
  <section class="demo band" id="demo" aria-labelledby="demo-title">
    <div class="container demo-grid">
      <div><p class="kicker">ソノバデの導入相談</p><h2 id="demo-title">まずは御社で使えるか、<br />無料でご相談ください。</h2></div>
      <div class="demo-booking">
        <ul>
          <li><img src="/sonovade/assets/lp/plan-icon.svg" width="24" height="24" alt="" />実際の操作を確認</li>
          <li><img src="/sonovade/assets/lp/document-icon.svg" width="24" height="24" alt="" />自社の書類に使えるか</li>
          <li><img src="/sonovade/assets/lp/yen-icon.svg" width="24" height="24" alt="" />料金・導入の相談</li>
        </ul>
        <a class="button" href={contact}>30分の無料相談を申し込む</a>
        <p>導入のご相談もこちらからお願いいたします。</p>
      </div>
    </div>
  </section>
  <dialog class="screen-dialog" data-screen-dialog aria-label="ソノバデの画面拡大">
    <button type="button" class="dialog-close" aria-label="拡大画面を閉じる" data-close>×</button>
    <img alt="" data-dialog-image />
  </dialog>
</SonovadeLayout>
