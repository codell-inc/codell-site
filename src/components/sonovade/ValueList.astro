---
import { values } from "../../data/sonovade";
---

<ol class="value-list">
  {values.map((value, index) => (
    <li>
      <div class="value-copy">
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h3>{value.titleLines[0]}<br />{value.titleLines[1]}</h3>
        <p>{value.description}</p>
      </div>
      <figure><img src={value.image.replace(".png", "-1280.webp")} srcset={`${value.image.replace(".png", "-640.webp")} 640w, ${value.image.replace(".png", "-1280.webp")} 1280w`} sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 980px) 52vw, 640px" alt={value.alt} width={value.width} height={value.height} loading="lazy" decoding="async" /></figure>
    </li>
  ))}
</ol>
