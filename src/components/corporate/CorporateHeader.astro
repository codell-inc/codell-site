---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const homeHref = isHome ? "#top" : "/";
const sectionHref = (id: string) => isHome ? `#${id}` : `/#${id}`;
---

<header class="site-header" data-header>
  <a class="brand" href={homeHref} aria-label="Codell トップへ">
    <img class="brand-logo" src="/assets/codell-logo.svg" alt="Codell" width="144" height="60" />
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle aria-label="メニューを開く">
    <span></span><span></span><span></span>
  </button>
  <nav class="site-nav" id="site-nav" data-nav>
    <details class="nav-services" data-nav-services>
      <summary>サービス</summary>
      <div class="nav-services-menu">
        <a href="/sonovade/"><strong>ソノバデ</strong><span>介護住宅改修の見積・申請</span></a>
        <a href="https://kiduki.codell.jp/"><strong>KiDUKi</strong><span>ARグラス × AI で、介護・家事代行の現場を支える</span></a>
        <a href="https://video.codell.jp/"><strong>動画制作</strong><span>動画 × AI で、伝わる映像を企画から納品まで</span></a>
      </div>
    </details>
    <a href={sectionHref("business")}>事業</a>
    <a href={sectionHref("work")}>業務内容</a>
    <a href={sectionHref("members")}>メンバー</a>
    <a href="/products/">プロダクト</a>
    <a href={sectionHref("development-flow")}>開発の流れ</a>
    <a href={sectionHref("company")}>会社概要</a>
    <a class="nav-contact" href="/contact.html">無料相談</a>
  </nav>
</header>
