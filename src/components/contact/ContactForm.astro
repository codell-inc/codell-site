---
interface Props { product?: "sonovade" }
const { product } = Astro.props;
const isSonovade = product === "sonovade";
const inquiries = [
  ["ソノバデの無料相談", "無料相談・画面を見てみたい"],
  ["ソノバデの見積もり依頼", "見積もりを依頼したい"],
  ["ソノバデの資料請求", "資料を請求したい"],
  ["ソノバデについて", "その他の質問"],
];
---
<form class="contact-form light" id="contact-form" data-product={product} novalidate>
  {isSonovade && <fieldset class="inquiry-options">
    <legend>お問い合わせの種類 <span aria-hidden="true">*</span></legend>
    {inquiries.map(([value, label], index) => <label class="inquiry-option">
      <input type="radio" name="type" value={value} checked={index === 0} required />
      <span>{label}</span>
    </label>)}
  </fieldset>}
  <div class="field">
    <label for="contact-company">会社名 {isSonovade && <span aria-hidden="true">*</span>}</label>
    <input type="text" id="contact-company" name="company_name" autocomplete="organization" required={isSonovade} />
  </div>
  {isSonovade && <>
    <div class="field">
      <label for="contact-employees">従業員数 <span aria-hidden="true">*</span></label>
      <select id="contact-employees" name="employee_count" required>
        <option value="" disabled selected>選択してください</option>
        <option value="1〜9名">1〜9名</option>
        <option value="10〜49名">10〜49名</option>
        <option value="50〜99名">50〜99名</option>
        <option value="100〜299名">100〜299名</option>
        <option value="300名以上">300名以上</option>
      </select>
    </div>
    <div class="field">
      <label for="contact-department">部署</label>
      <input type="text" id="contact-department" name="department" />
    </div>
    <div class="field">
      <label for="contact-job-title">役職 <span aria-hidden="true">*</span></label>
      <input type="text" id="contact-job-title" name="job_title" autocomplete="organization-title" required />
    </div>
  </>}
  <div class="field">
    <label for="contact-name">{isSonovade ? "姓名" : "お名前"} <span aria-hidden="true">*</span></label>
    <input type="text" id="contact-name" name="name" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="contact-email">メールアドレス <span aria-hidden="true">*</span></label>
    <input type="email" id="contact-email" name="email" autocomplete="email" required />
  </div>
  {!isSonovade && <div class="field">
    <label for="contact-type">問い合わせ種別 <span aria-hidden="true">*</span></label>
    <select id="contact-type" name="type" required>
      <option value="" disabled selected>選択してください</option>
      <option value="ソノバデについて">ソノバデについて</option>
      <option value="ソノバデの見積もり依頼">ソノバデの見積もり依頼</option>
      <option value="ソノバデの資料請求">ソノバデの資料請求</option>
      <option value="KiDUKiについて">KiDUKiについて</option>
      <option value="プロダクト開発相談">プロダクト開発相談</option>
      <option value="その他">その他</option>
    </select>
  </div>}
  <div class="field">
    <label for="contact-discovery">{isSonovade ? "ソノバデ" : "Codell"}を知ったきっかけ <span aria-hidden="true">*</span></label>
    <select id="contact-discovery" name="discovery_source" required>
      <option value="" disabled selected>選択してください</option>
      <option value="検索">検索（Google・Yahoo!など）</option>
      <option value="広告">広告</option>
      <option value="イベントから">イベントから</option>
      <option value="友人から">友人から</option>
      <option value="新聞から">新聞から</option>
      <option value="その他">その他</option>
    </select>
  </div>
  <div class="field" id="contact-discovery-other-field" hidden>
    <label for="contact-discovery-other">その他のきっかけ <span aria-hidden="true">*</span></label>
    <input type="text" id="contact-discovery-other" name="discovery_other" />
  </div>
  <div class="field">
    <label for="contact-message">問い合わせ内容 {!isSonovade && <span aria-hidden="true">*</span>}</label>
    <textarea id="contact-message" name="message" rows="6" required={!isSonovade}></textarea>
  </div>
  <p class="form-privacy">送信前に、<a href="/privacy/">プライバシーポリシー</a>をご確認ください。入力された情報は、お問い合わせへの回答やご相談内容に応じた連絡に利用します。</p>
  <div class="form-foot">
    <p class="form-status" id="contact-status" role="status" aria-live="polite"></p>
    <button type="submit" class="button primary" id="contact-submit">送信する</button>
  </div>
</form>
